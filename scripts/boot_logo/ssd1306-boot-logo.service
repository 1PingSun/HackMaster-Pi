[Unit]
Description=SSD1306 OLED Boot Logo (Cat)
After=local-fs.target dev-i2c-1.device
DefaultDependencies=no

[Service]
Type=idle
ExecStart=/usr/local/bin/ssd1306_boot_logo
Restart=no
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
TimeoutStartSec=10

[Install]
WantedBy=local-fs.target